# ---- Secrets & local machine config ----
.env
*.env
!.env.example
/TEAM_GUIDE.md

# ---- Data (confidential) ----
# The whole data/ tree is ignored EXCEPT the public glossary and the
# knowledge-pack manifest TEMPLATE (the downloaded public files and the real
# manifest stay local). NEVER force-add anything else under data/.
data/*
!data/glossary/
data/glossary/*
!data/glossary/*.yaml
!data/glossary/*.yml
!data/knowledge_pack/
data/knowledge_pack/*
!data/knowledge_pack/manifest.example.yaml

# ---- Models & vector store (large / machine-local) ----
# Leading slash: anchor to repo root ONLY — an unanchored "models/" also
# matches app/models/ (the shared schemas module) and silently drops it
# from version control. Same reasoning for qdrant_storage/.
/models/
/qdrant_storage/

# ---- Native (no-Docker) runtime state ----
/open_webui_data/
/logs/
/run/

# ---- Python ----
# Anchored to repo root: an unanchored "dist/" would also match
# app/static/dist/, the frontend build output, which IS committed
# (REDESIGN_PROMPT.md — deployment ships the built bundle, no Node required).
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
/build/
/dist/
.venv/
venv/
env/
.python-version

# ---- Frontend (dev-machine only; app/static/dist/ build output IS committed) ----
frontend/node_modules/

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
*.swp

# ---- Ingestion artifacts (extracted figure images, etc.) ----
data/assets/
*.log

# ---- Eval outputs (per-run JSON reports; compare locally, don't commit) ----
/eval/results/
# Local reference material for golden-set authoring; not read by any code path
# (eval/run_ragas.py doesn't import it) and has held real-company-name content
# in the past (SEC5, 2026-08-05 audit) — never force-add it.
/eval/golden_set_reference.json
.webui_secret_key
.venv-webui/
