# ---- Secrets & local machine config ----
.env
*.env
!.env.example
/TEAM_GUIDE.md

# ---- Data (confidential) ----
# The whole data/ tree is ignored EXCEPT the public glossary and the
# knowledge-pack manifest TEMPLATE (the downloaded public files and the real
# manifest stay local). NEVER force-add anything else under data/.
data/*
!data/glossary/
data/glossary/*
!data/glossary/*.yaml
!data/glossary/*.yml
!data/knowledge_pack/
data/knowledge_pack/*
!data/knowledge_pack/manifest.example.yaml

# ---- Models & vector store (large / machine-local) ----
# Leading slash: anchor to repo root ONLY — an unanchored "models/" also
# matches app/models/ (the shared schemas module) and silently drops it
# from version control. Same reasoning for qdrant_storage/.
/models/
/qdrant_storage/

# ---- Native runtime state ----
/open_webui_data/
/logs/
/run/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
*.swp

# ---- Ingestion artifacts (extracted figure images, etc.) ----
data/assets/
*.log

# ---- Eval outputs (per-run JSON reports; compare locally, don't commit) ----
/eval/results/
.webui_secret_key
.venv-webui/
