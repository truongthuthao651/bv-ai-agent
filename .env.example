# =============================================================================
# Local RAG Assistant — environment template
# Copy this file to `.env` on each machine and adjust as needed.
#   cp .env.example .env
# Nothing here is a secret by design (fully-local, air-gapped stack), but .env
# is gitignored so per-machine values never get committed.
# All of these are read by app/config/settings.py — do not read env vars anywhere else.
# =============================================================================

# ---- Application server (FastAPI) ----
# 127.0.0.1 keeps the API (and its unauthenticated admin page / /ingest /
# DELETE endpoints) reachable only from this machine — employees on the LAN
# can only reach Open WebUI (port 3000), which requires login. Open WebUI and
# its ingest pipe still work: they call the API via localhost on this machine.
API_HOST=127.0.0.1
API_PORT=8000
# Base URL the API is actually reachable at. Used to build citation links back
# to the original source file (GET /documents/{doc_id}/file) in chat answers.
# Only reliably clickable from wherever this base URL is actually reachable
# from (by default: the same machine, matching API_HOST=127.0.0.1 above).
# LAN NOTE: employees reach the chat UI over the LAN, but a loopback value here
# makes every citation open the reader's OWN localhost (dead for them). To make
# citations clickable for staff, set this to this machine's LAN address (e.g.
# http://192.168.1.20:8000), bind API_HOST=0.0.0.0 so the read-only
# /documents/{id}/view and /file routes are reachable, and KEEP ADMIN_PASSWORD
# set so upload/delete stay protected. The API logs a warning when this is
# loopback. Leave as-is to accept server-only citations.
API_PUBLIC_BASE_URL=http://localhost:8000
# Single shared password gating the admin dashboard (upload/delete/quick-ask
# at http://localhost:8000). Empty = gate disabled (today's default: open on
# loopback). This is NOT the employee-facing login — that's Open WebUI's own
# WEBUI_AUTH below. Set a real value before letting anyone else use this machine.
ADMIN_PASSWORD=
LOG_LEVEL=INFO
# Show a small "⏱ Thời gian trả lời: 1m55s" footer below each answer so staff
# see how long their question took (measured end-to-end: retrieval + generation).
SHOW_RESPONSE_TIME=true
# Append one metadata-only line per answered question (elapsed, mode, hit count,
# query/answer lengths — never the query or answer text) to the file below, for
# latency analysis and evaluation. Strictly LOCAL — nothing leaves the machine.
QUERY_TIMING_LOG_ENABLED=true
QUERY_TIMING_LOG_PATH=./logs/query_timings.jsonl
# Pre-load bge-m3 + reranker weights, the Qdrant collection, and the Ollama chat
# model at startup so the first request isn't cold (big win on CPU). Best-effort:
# failures are logged, never fatal. Set false to keep startup light.
WARMUP_ON_STARTUP=true
# Comma-separated list of allowed CORS origins (Open WebUI, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Ollama (chat / vision / embeddings serving) ----
# Install Ollama once from https://ollama.com (needs network at setup only).
# It serves on localhost:11434 and scripts/run_native.sh starts it if needed.
OLLAMA_BASE_URL=http://localhost:11434
# Weak machines may drop CHAT_MODEL to qwen3:4b without any code change.
CHAT_MODEL=qwen3:8b
VISION_MODEL=qwen2.5vl:7b
EMBED_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3
# Local weight dirs for FlagEmbedding — bge-m3 produces dense+sparse vectors
# and the reranker scores. Populated by setup_models.sh. Paths are relative to
# where the app runs: the repository root.
EMBED_MODEL_PATH=./models/bge-m3
RERANK_MODEL_PATH=./models/bge-reranker-v2-m3
# Generation controls
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=8192
# How many trailing chat turns are sent to the model as history (retrieval
# re-grounds each turn, so this stays small for the local model's context).
MAX_HISTORY_TURNS=6
# Reasoning models (qwen3) emit hidden <think> tokens that dominate CPU latency.
# Keep false to skip them (much faster); set true only to debug reasoning.
LLM_THINKING=false
# Seconds to wait on an Ollama request before giving up.
OLLAMA_TIMEOUT=120
# How long Ollama keeps the chat model loaded after a request. Default Ollama
# behavior is ~5 minutes, meaning the first question after a coffee break pays
# a full model reload. Duration string ("2h", "30m") or -1 = keep forever.
OLLAMA_KEEP_ALIVE=2h

# ---- Qdrant (vector DB) ----
# QDRANT_LOCAL_PATH set means the vector DB runs EMBEDDED inside the API process
# (qdrant-client local mode) and persists to this directory. The directory is
# single-process (file-locked): stop the API before running eval/run_ragas.py.
# Leave it empty only when intentionally using an external Qdrant server at
# QDRANT_URL.
QDRANT_LOCAL_PATH=./qdrant_storage/local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=insurance_docs
# Vector sizes / distance for the bge-m3 dense vectors.
DENSE_VECTOR_SIZE=1024
DENSE_DISTANCE=Cosine

# ---- Retrieval / reranking ----
# top-k pulled from EACH of dense & sparse before RRF fusion.
RETRIEVE_TOP_K=20
# RRF constant (k in 1/(k+rank)).
RRF_K=60
# results kept after reranking, fed to generation.
RERANK_TOP_K=5
# Drop reranked hits scoring below this (normalized 0-1). When nothing
# survives, the API answers "Tôi không tìm thấy thông tin trong tài liệu."
# deterministically instead of letting the LLM guess from irrelevant context.
# 0 disables the floor. Calibration on the synthetic corpus: off-topic queries
# score <=0.001, related secondary chunks ~0.05-0.15, direct hits 0.6-0.95 —
# keep this LOW (0.05); higher values starve the model of context and cause
# false refusals. Tune against eval/run_ragas.py results.
RERANK_MIN_SCORE=0.05
# Relative floor: also drop hits scoring below this FRACTION of the top hit's
# score. Suppresses a weak tangential chunk from an unrelated document (e.g. a
# claims-payout spreadsheet row sharing a product name + a header word) from
# padding the context when a strong top hit exists. 0 disables it (default).
# Enable cautiously (e.g. 0.3–0.4) and re-run eval/run_ragas.py before deploying.
RERANK_MIN_RATIO=0.0
# Enable glossary-based synonym expansion of the query (no LLM call).
ENABLE_QUERY_EXPANSION=true
# Enable standalone-question rewriting from chat history.
ENABLE_QUERY_REWRITE=true
# Sticky product/document across turns: reinject the last-cited doc title (or
# prior user-named product) into follow-ups that drop the name, and refuse the
# hybrid general-knowledge fallback for those scoped company-document questions.
CONVERSATION_SCOPE_ENABLED=true
# Ask the user to confirm before answering when the query likely garbles a
# known glossary term or document title (e.g. "bao hiem lieen keet chung" for
# "bảo hiểm liên kết chung") instead of silently guessing. No LLM call.
SPELLCHECK_ENABLED=true
# Similarity band (0-1, diacritic-folded) treated as "probable typo": below
# SPELLCHECK_MIN_RATIO isn't similar enough to flag; at/above
# SPELLCHECK_MAX_RATIO the query already spells the term correctly.
SPELLCHECK_MIN_RATIO=0.82
SPELLCHECK_MAX_RATIO=0.985
# When retrieval finds no matching company document at all, answer from
# general knowledge instead of refusing outright — always clearly labeled, and
# the model still refuses for anything company-specific it can't know. False
# restores the old behavior: refuse deterministically on zero hits.
HYBRID_FALLBACK_ENABLED=true
# Refuse when a query names a specific product but every retrieved document is a
# DIFFERENT product (near-identical benefit clauses otherwise fool the reranker
# into answering from — and citing — the wrong product). False disables it.
PRODUCT_SCOPE_GUARD_ENABLED=true
# Comparison questions naming ≥2 products: retrieve+rerank per product and merge
# so one product's chunks cannot crowd the other out of the global top-k.
# False = single global pool (old behaviour; starves side-by-side answers).
COMPARISON_RETRIEVAL_ENABLED=true
# Chunks kept per named product before merge (2×3 = 6 in generation context).
COMPARISON_PER_PRODUCT_TOP_K=3
# Max named products that each get their own retrieval pass (CPU cost scales).
COMPARISON_MAX_PRODUCTS=3
# Drop fee / guaranteed-interest chunks from benefit-payout queries so
# "claim bao nhiêu%?" cannot be answered from a lãi suất cam kết table.
METRIC_GUARD_ENABLED=true
# Advisory / synthesis answers for comparison and "KH nên chọn sản phẩm nào?"
# questions: the documents hold the facts but never that conclusion, so the
# strict prompt refuses them outright. Every datum still comes from the
# retrieved context (and a wrong/absent product is still refused); the answer
# is labeled as an internal synthesis, not official product advice.
# False = strict-only behaviour (refuses advisory questions).
ADVISORY_MODE_ENABLED=true
# Let a grounded answer append ONE clearly-fenced "Kiến thức chung (ngoài tài
# liệu)" section of textbook insurance knowledge after the document-sourced
# part. Never replaces it, never carries company specifics, always labeled.
# This is the model's own knowledge — NO web access is involved.
GENERAL_KNOWLEDGE_SUPPLEMENT_ENABLED=true

# ---- Chunking ----
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800
# Fractional overlap between adjacent chunks (10-15%).
CHUNK_OVERLAP_PCT=0.12

# ---- Ingestion / parsing ----
OCR_LANGUAGE=vi
# Route a PDF page to OCR when its text layer averages fewer chars/page than this.
PDF_MIN_CHARS_PER_PAGE=20
# PDF text-extraction backend: pypdfium2 (default) or docling-parse.
# docling-parse garbles Vietnamese diacritics in some professionally typeset
# PDFs (InDesign policy booklets); pypdfium2 decodes them correctly.
PDF_BACKEND=pypdfium2
# Turn on Docling formula enrichment (PDF formulas -> LaTeX).
DO_FORMULA_ENRICHMENT=true
# Docling model weights dir (pre-fetched by setup_models.sh for offline PDF
# parsing; ignored while missing/empty — docling then downloads on first PDF).
# NOTE: must not be renamed to DOCLING_ARTIFACTS_PATH — docling reads that env
# var itself and errors out when the directory doesn't exist yet.
DOCLING_MODELS_PATH=./models/docling
# Run LLM/VLM enrichment (formula verbalization + figure description) at ingest time.
ENABLE_ENRICHMENT=true

# ---- Paths (relative to the repository root) ----
DATA_DIR=./data
SYNTHETIC_DIR=./data/synthetic
# data/real/ is off-limits to application code; kept here only so nothing hardcodes it.
GLOSSARY_PATH=./data/glossary/thuat_ngu.yaml
# Where extracted figure/chart images are written during ingestion.
ASSET_DIR=./data/assets

# ---- Assistant identity / branding ----
# Display name shown in Open WebUI (tab/header) and the admin page. The local
# model never changes — this is presentation only. Change per company.
ASSISTANT_NAME=Trợ lý AI Bảo Việt Life
# OpenAI-style model id advertised by GET /v1/models and pre-selected by Open
# WebUI (DEFAULT_MODELS below must match this).
ASSISTANT_MODEL_ID=bao-viet-life

# ---- Open WebUI (frontend) ----
# Host port the browser hits.
OPEN_WEBUI_PORT=3000
# WebUI talks to this OpenAI-compatible endpoint (our local FastAPI app).
OPENAI_API_BASE_URL=http://localhost:8000/v1
# Open WebUI requires a key string even for local use; any non-empty value works.
OPENAI_API_KEY=local-no-auth
# Require login on Open WebUI (RBAC). The FIRST account created becomes admin
# (register it right after first start). Public signup is off after that: the
# admin creates each employee account in Admin Panel > Users > "+" (role
# "user"). Employees see only chat; the Admin Panel, raw Ollama models, and
# the ingest pipe stay admin-only. See README "Tài khoản & phân quyền".
# Do NOT flip this back to false once users exist: Open WebUI will refuse to start.
WEBUI_AUTH=true
# App name in the Open WebUI tab/header, and model pre-selected in new chats.
WEBUI_NAME=Trợ lý AI Bảo Việt Life
DEFAULT_MODELS=bao-viet-life

# ---- Departments (phòng ban) ----
# Comma-separated list of departments selectable when uploading a document and
# editable per document in the admin page. Source of truth for validation; the
# admin UI mirrors this list. Change to match the company's org chart.
DEPARTMENTS=PTSP,DP,DVA
